# Copy to .env beside this file. Every line here is commented out, so a copy
# changes nothing: the stack comes up on a clean machine with no preparation.
#
# The file does two jobs. The names without a COMETTRACE_ prefix are read by
# the compose file itself, to fill in a password or a port. The ones with it
# are handed to the server, which reads any COMETTRACE_<BLOCK>__<FIELD> as
# the field of a block in comettrace.toml.

# ---------------------------------------------------------------- the stack

# The three stores default to `comettrace`, which is fine for a laptop and
# nothing else. Change both before this faces anything real — and before
# widening POSTGRES_BIND, which is what would put that database on a network.
#POSTGRES_PASSWORD=
#CLICKHOUSE_PASSWORD=
#POSTGRES_BIND=127.0.0.1
#POSTGRES_PORT=5432

#OTLP_GRPC_PORT=4317
#OTLP_HTTP_PORT=4318
#RETENTION_DAYS=30
#RUST_LOG=info

# false because this compose file serves plain HTTP. Put the server behind
# TLS and set it to true, or session cookies travel in the clear.
#COOKIE_SECURE=false

# A published image to run instead of building from this checkout.
#COMETTRACE_IMAGE=ghcr.io/comettrace/comettrace:1.2.3

# ------------------------------------------------- signing in with an idp

# Set the four and local passwords become unnecessary.
#COMETTRACE_OIDC__ISSUER=https://id.example.com
#COMETTRACE_OIDC__CLIENT_ID=comettrace
#COMETTRACE_OIDC__CLIENT_SECRET=
#COMETTRACE_OIDC__REDIRECT_URI=https://comettrace.example.com/auth/oidc/callback
#COMETTRACE_LOCAL_PASSWORD=false

# ----------------------------------------------------------- the mail relay

# Without one, nobody can ask for a reset link on the sign-in screen; hand
# one over with `comettrace reset-password` instead.
#COMETTRACE_MAIL__RELAY=mail.example.com
#COMETTRACE_MAIL__USERNAME=postmaster
#COMETTRACE_MAIL__PASSWORD=
#COMETTRACE_MAIL__FROM=Comettrace <no-reply@example.com>
#COMETTRACE_MAIL__BASE_URL=https://comettrace.example.com
